diff --git a/hw/xtensa/esp32s3.c b/hw/xtensa/esp32s3.c
index 62f5817..a1b2c3d 100644
--- a/hw/xtensa/esp32s3.c
+++ b/hw/xtensa/esp32s3.c
@@ -61,6 +61,7 @@
 #include "hw/misc/esp32s3_ds.h"
 #include "hw/timer/esp32s3_timg.h"
 #include "hw/timer/esp32s3_systimer.h"
+#include "hw/xtensa/bramble_adc.h"
 #include "hw/gpio/esp32s3_gpio.h"
 #include "hw/misc/esp32s3_xts_aes.h"
 #include "hw/misc/esp32s3_pms.h"
@@ -879,5 +880,13 @@ static void esp32s3_machine_init(MachineState *machine)
         memory_region_add_subregion_overlap(sys_mem, esp32s3_memmap[ESP32S3_MEMREGION_FRAMEBUF].base, &ss->rgb.vram, 0);
     }

+    /* Bramble SAR ADC oneshot stub (P2.3b). Overlays the unmodeled SENS window
+     * so the pager's battery_read_mv() oneshot conversion latches "done"
+     * instead of spinning, unwedging boot past battery_init into the main loop.
+     * Needs only the system memory (no SoC state, no interrupt: the pager polls
+     * the ADC), but wired here beside the other bramble overlays. Placed in the
+     * peripheral-realization run, clear of the P2.2 scaffold/gpio and P2.3
+     * gpspi2 attach sites, so all bramble patches re-apply idempotently. */
+    bramble_adc_attach(get_system_memory());
     esp32s3_soc_add_unimp_device(sys_mem, "esp32s3.rmt", DR_REG_RMT_BASE, 0x1000);
     esp32s3_soc_add_unimp_device(sys_mem, "esp32s3.iomux", DR_REG_IO_MUX_BASE, 0x2000);
