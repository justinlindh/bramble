 #define IRQ_MAP(cpu, input) s->irq_map[cpu][input]
 
+/* Drive the CPU interrupt line `out_index` on `cpu_index` to the OR of every
+ * source input currently routed to it. A real interrupt matrix is
+ * combinational: each CPU interrupt reflects the live OR of the sources mapped
+ * to it, so (a) a level asserted before its source is routed still reaches the
+ * CPU once the map selects it, and (b) rerouting a source away from a line (as
+ * esp_intr_disable does, by pointing the source at a disabled interrupt number)
+ * releases that line. The stock model forwarded only on input edges to the
+ * then-current map, so it did neither: the SPI2 trans-done line the
+ * interrupt-driven spi_master relies on latches before esp_intr_alloc runs and
+ * never reached the CPU, and once it did, disabling by rerouting left the old
+ * line stuck asserted (interrupt storm). */
+static void esp32s3_intmatrix_drive(Esp32s3IntMatrixState *s, int cpu_index,
+                                    int out_index)
+{
+    if (s->outputs[cpu_index] == NULL) {
+        return;
+    }
+    int level = 0;
+    for (int src = 0; src < ESP32S3_INT_MATRIX_INPUTS; ++src) {
+        if (IRQ_MAP(cpu_index, src) == out_index && s->input_level[src]) {
+            level = 1;
+            break;
+        }
+    }
+    for (int int_index = 0; int_index < s->cpu[cpu_index]->env.config->nextint; ++int_index) {
+        if (s->cpu[cpu_index]->env.config->extint[int_index] == out_index) {
+            qemu_set_irq(s->outputs[cpu_index][int_index], level);
+            break;
+        }
+    }
+}
