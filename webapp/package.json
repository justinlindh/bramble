{
  "name": "bramble-webapp",
  "version": "1.4.0",
  "description": "Bramble mesh networking desktop app",
  "author": "Bramble Mesh <info@bramblemesh.org>",
  "homepage": "https://bramblemesh.org",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "gen:rpc-types": "npx -y openapi-typescript@7.13.0 ../api/openapi.yaml -o src/types/rpcContract.generated.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node server/unified-server.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e:smoke": "bash scripts/unified-runtime-smoke.sh",
    "dev:electron": "electron-vite dev",
    "build:electron": "electron-vite build",
    "package": "electron-vite build && electron-builder --config electron-builder.yml",
    "package:linux": "electron-vite build && electron-builder --linux --config electron-builder.yml",
    "package:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "package:win": "electron-vite build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/qrcode": "^1.5.6",
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.6.2",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  }
}
