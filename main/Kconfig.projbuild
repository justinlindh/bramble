menu "Bramble Configuration"

    choice BRAMBLE_BOARD
        prompt "Board selection"
        default BRAMBLE_BOARD_HELTEC_V3

        config BRAMBLE_BOARD_HELTEC_V3
            bool "Heltec WiFi LoRa 32 V3 (SX1262)"

        config BRAMBLE_BOARD_HELTEC_V4
            bool "Heltec WiFi LoRa 32 V4 (ESP32-S3 + SX1262 + optional GNSS)"

        config BRAMBLE_BOARD_TDECK_PLUS
            bool "LILYGO T-Deck Plus (ESP32-S3 + SX1262 + GPS + Keyboard)"

        config BRAMBLE_BOARD_TTGO_LORA32
            bool "TTGO LoRa32 (SX1276)"

        config BRAMBLE_BOARD_CUSTOM
            bool "Custom board"
    endchoice

    config BRAMBLE_TX_POWER
        int "TX power (dBm)"
        default 17
        range 2 22

    choice BRAMBLE_RADIO_PROFILE
        prompt "Radio profile"
        default BRAMBLE_PROFILE_LONG_RANGE

        config BRAMBLE_PROFILE_LONG_RANGE
            bool "Long range (SF10, 125kHz)"

        config BRAMBLE_PROFILE_BALANCED
            bool "Balanced (SF8, 250kHz)"

        config BRAMBLE_PROFILE_FAST
            bool "Fast (SF7, 500kHz)"
    endchoice

    choice BRAMBLE_REGION
        prompt "Bramble frequency region"
        default BRAMBLE_REGION_US915
        help
            Select the regulatory region for LoRa radio operation.

        config BRAMBLE_REGION_US915
            bool "US915 (FCC 902-928 MHz)"

        config BRAMBLE_REGION_EU868
            bool "EU868 (ETSI 863-870 MHz)"

        config BRAMBLE_REGION_AU915
            bool "AU915 (ACMA 915-928 MHz)"

    endchoice

    config BRAMBLE_OTA_ALLOW_HTTP
        bool "Allow plain-HTTP OTA downloads (dev only)"
        default n
        help
            Compile in the plain-HTTP OTA download path so a LAN dev server
            (python3 -m http.server) can feed the device. Image signature
            verification still applies; only transport confidentiality and
            server authentication are lost. Never enable on release builds.

    menu "Bramble Message Persistence"
        config BRAMBLE_MSG_PERSIST_ENABLED
            bool "Enable message persistence to SPIFFS"
            default y

        config BRAMBLE_MSG_PERSIST_MAX
            int "Maximum persisted messages"
            default 200
            range 50 1000
            depends on BRAMBLE_MSG_PERSIST_ENABLED

        config BRAMBLE_MSG_PERSIST_ROLLOVER_KEEP_PCT
            int "Percentage of messages to keep on rollover"
            default 75
            range 50 90
            depends on BRAMBLE_MSG_PERSIST_ENABLED
    endmenu

endmenu
