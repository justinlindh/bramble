menu "Bramble RPC"

config BRAMBLE_RPC_ENABLED
    bool "Enable JSON-RPC dispatcher"
    default y

config BRAMBLE_RPC_MAX_REQUEST
    int "Max JSON-RPC request size (bytes)"
    default 1024

config BRAMBLE_RPC_MAX_RESPONSE
    int "Max JSON-RPC response size (bytes)"
    default 2048

config BRAMBLE_RPC_MAX_METHODS
    int "Max registered RPC methods"
    # 64, not 40: the firmware registers 61 methods and every shipped profile
    # already overrode this to 64; a 40 default silently drops registrations
    # on any build that forgets the override (the nRF target nearly did).
    default 64

endmenu
