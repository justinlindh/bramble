docs/archive/
docs/superpowers/
docs/plans/

# Local helper state
.flash-targets.json
reports/
webapp/node_modules

# OTA signing keys: private key must never be committed
keys/*
!keys/README.md
!keys/ota-release-pub.pem

# session scratch (never commit)
.superpowers/
.claude/worktrees/

# KiCad editor state and lock files (per-machine, never shared)
*.kicad_prl
*.lck
~*.lck

# Internal AI-assistant ops docs, kept local/private (not shipped public)
/.claude/
