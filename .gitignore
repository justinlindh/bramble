*.o
*.obj
*.a
*.d
*.elf
*.map
*.bin

# Local SDK config/state
sdkconfig
sdkconfig.*
!sdkconfig.defaults*
sdkconfig.old
!test/stubs/sdkconfig.h

# Dependency/build management
managed_components/
dependencies.lock

# Temp/evidence artifacts
tmp-e2e/
*.log
.cache/

