CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BRAMBLE_BOARD_TDECK_PLUS=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.tdeck_plus.csv"

# LVGL fonts for graphical UI
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# Message persistence defaults (T-Deck has much larger SPIFFS partition)
CONFIG_BRAMBLE_MSG_PERSIST_ENABLED=y
CONFIG_BRAMBLE_MSG_PERSIST_MAX=300
CONFIG_BRAMBLE_MSG_PERSIST_ROLLOVER_KEEP_PCT=75
