CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BRAMBLE_BOARD_TDECK_PLUS=y

# T-Deck default profile is WiFi-first (BLE disabled) to avoid AP auth instability
# observed with BLE enabled on current ESP-IDF/board stack.
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_CONTROLLER_DISABLED=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.tdeck_plus.csv"

# T-Deck Plus uses USB Serial/JTAG as the host-facing console/CLI transport.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Extra headroom for heavy board bring-up paths.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL fonts for graphical UI
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# Message persistence defaults (T-Deck has much larger SPIFFS partition)
CONFIG_BRAMBLE_MSG_PERSIST_ENABLED=y
CONFIG_BRAMBLE_MSG_PERSIST_MAX=300
CONFIG_BRAMBLE_MSG_PERSIST_ROLLOVER_KEEP_PCT=75
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# Use clib malloc for LVGL so memory goes to PSRAM via SPIRAM_USE_MALLOC
# instead of a 64KB static BSS pool in internal DRAM
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=y
