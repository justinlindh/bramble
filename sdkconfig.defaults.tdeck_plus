CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BRAMBLE_BOARD_TDECK_PLUS=y

# Power: dynamic frequency scaling (240 MHz busy / 80 MHz idle, light sleep
# off). The esp_pm_configure() call in main.c documents the full rationale;
# min 80 MHz keeps the APB clock fixed at 80 MHz so peripheral clocks (GPS
# UART baud, backlight LEDC PWM, shared display/radio SPI, keyboard I2C)
# never shift when the CPU scales.
CONFIG_PM_ENABLE=y

# BLE: NimBLE compiled in for this profile (overrides the WiFi-first global
# default). Runtime connectivity modes are exclusive (Settings > Connectivity,
# WiFi, BLE, or Off, reboot to apply), so the BT controller is initialized only
# when the persisted mode is BLE; a WiFi- or Off-mode boot never starts it. The
# AP WPA handshake instability that motivated disabling BLE here (commit 7eefcf33)
# was observed with WiFi and BLE running concurrently, a configuration
# conn_mode_resolve_boot coerces to WiFi-only. NimBLE tuning (MTU, roles,
# SM/link security, bond persistence) comes from the global defaults.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
# NimBLE host task stack: mirror the heltec_v4 profile's 8192. The 4096
# default is the stack size that has overflowed twice before in this
# firmware for tasks doing GATT callbacks plus NVS persist writes.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
CONFIG_BT_NIMBLE_TASK_STACK_SIZE=8192

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.tdeck_plus.csv"

# T-Deck Plus uses USB Serial/JTAG as the host-facing console/CLI transport.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Extra headroom for heavy board bring-up paths.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL fonts for graphical UI
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# bramble.screenshot RPC (bench debug tooling): lv_snapshot_take_to_buf
CONFIG_LV_USE_SNAPSHOT=y

# Message persistence defaults (T-Deck has much larger SPIFFS partition)
CONFIG_BRAMBLE_MSG_STORE_CAP=200
CONFIG_BRAMBLE_MSG_PERSIST_ENABLED=y
CONFIG_BRAMBLE_MSG_PERSIST_MAX=300
CONFIG_BRAMBLE_MSG_PERSIST_ROLLOVER_KEEP_PCT=75
# NOTE: Do NOT enable CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY here.
# It places .bss in PSRAM, causing hard abort() if PSRAM init fails on boot
# (octal_psram: PSRAM ID read error). T-Deck Plus PSRAM is sensitive to reset
# timing and occasionally fails to initialize. All PSRAM usage goes through
# SPIRAM_USE_MALLOC + clib malloc instead, which gracefully falls back.

# LVGL uses clib malloc (standard malloc/free), which is routed to PSRAM by
# SPIRAM_USE_MALLOC=y above. HOWEVER: SPIRAM_MALLOC_ALWAYSINTERNAL defaults to
# 16384, meaning ALL allocations ≤16KB go to internal RAM first. LVGL's object
# tree consists of hundreds of small allocations, exhausting internal RAM and
# silently preventing the ui_gfx task from starting (blank display).
#
# Setting ALWAYSINTERNAL=0 makes clib malloc prefer PSRAM for ALL allocations.
# Code that truly needs internal/DMA RAM uses heap_caps_malloc(MALLOC_CAP_DMA)
# explicitly and is unaffected by this setting.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Use custom malloc for LVGL that explicitly targets PSRAM via heap_caps_malloc.
# LV_USE_CLIB_MALLOC uses plain malloc() which can trigger TLSF assert when
# internal RAM (~5KB) is nearly exhausted, even with SPIRAM_MALLOC_ALWAYSINTERNAL=0.
# The custom allocator in lv_malloc_psram.c uses heap_caps_malloc(MALLOC_CAP_SPIRAM)
# to guarantee LVGL widget allocations go to PSRAM, not internal RAM.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=n
CONFIG_LV_USE_CUSTOM_MALLOC=y

# WiFi buffer counts: compromise between internal DRAM savings and stability.
# Original defaults (32/32/10) are too aggressive for T-Deck's tight internal RAM,
# but 8/8/4 starved the Wi-Fi TX path under sustained mesh notification traffic,
# causing AP disassociation and WS drops. 16/16/6 is the middle ground.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# Extend WDT timeout for T-Deck: the shared SPI bus (display + radio) means
# the mesh task can block on spi_device_acquire_bus() during display flushes.
# 5s is too tight when LVGL does rapid redraws + LBT backoff stacks up.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_BRAMBLE_RPC_MAX_METHODS=96
