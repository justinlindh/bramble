CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_BRAMBLE_BOARD_TDECK_PLUS=y

# T-Deck default profile is WiFi-first (BLE disabled) to avoid AP auth instability
# observed with BLE enabled on current ESP-IDF/board stack.
# CONFIG_BT_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BT_CONTROLLER_DISABLED=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.tdeck_plus.csv"

# T-Deck Plus uses USB Serial/JTAG as the host-facing console/CLI transport.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Extra headroom for heavy board bring-up paths.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL fonts for graphical UI
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_18=y

# Message persistence defaults (T-Deck has much larger SPIFFS partition)
CONFIG_BRAMBLE_MSG_PERSIST_ENABLED=y
CONFIG_BRAMBLE_MSG_PERSIST_MAX=300
CONFIG_BRAMBLE_MSG_PERSIST_ROLLOVER_KEEP_PCT=75
# NOTE: Do NOT enable CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY here.
# It places .bss in PSRAM, causing hard abort() if PSRAM init fails on boot
# (octal_psram: PSRAM ID read error). T-Deck Plus PSRAM is sensitive to reset
# timing and occasionally fails to initialize. All PSRAM usage goes through
# SPIRAM_USE_MALLOC + clib malloc instead, which gracefully falls back.

# LVGL uses clib malloc (standard malloc/free), which is routed to PSRAM by
# SPIRAM_USE_MALLOC=y above. HOWEVER: SPIRAM_MALLOC_ALWAYSINTERNAL defaults to
# 16384, meaning ALL allocations ≤16KB go to internal RAM first. LVGL's object
# tree consists of hundreds of small allocations, exhausting internal RAM and
# silently preventing the ui_gfx task from starting (blank display).
#
# Setting ALWAYSINTERNAL=0 makes clib malloc prefer PSRAM for ALL allocations.
# Code that truly needs internal/DMA RAM uses heap_caps_malloc(MALLOC_CAP_DMA)
# explicitly and is unaffected by this setting.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0

# Use custom malloc for LVGL that explicitly targets PSRAM via heap_caps_malloc.
# LV_USE_CLIB_MALLOC uses plain malloc() which can trigger TLSF assert when
# internal RAM (~5KB) is nearly exhausted, even with SPIRAM_MALLOC_ALWAYSINTERNAL=0.
# The custom allocator in lv_malloc_psram.c uses heap_caps_malloc(MALLOC_CAP_SPIRAM)
# to guarantee LVGL widget allocations go to PSRAM, not internal RAM.
CONFIG_LV_USE_BUILTIN_MALLOC=n
CONFIG_LV_USE_CLIB_MALLOC=n
CONFIG_LV_USE_CUSTOM_MALLOC=y

# Reduce WiFi dynamic buffer counts to conserve internal DRAM.
# Default of 32 is aggressive for Bramble's low-throughput RPC/telemetry use.
# Each buffer is ~1.6KB in internal DMA-capable RAM.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
