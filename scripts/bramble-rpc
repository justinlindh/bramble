#!/usr/bin/env python3
"""Serial JSON-RPC client for bench nodes.

Usage:
  bramble-rpc PORT METHOD [PARAMS_JSON]
  bramble-rpc /dev/ttyACM1 bramble.getStatus
  bramble-rpc /dev/ttyACM1 bramble.sendBroadcast '{"text":"hi"}'

Notes (hard-won):
- Opens with exclusive=True and bounded reads: USB-JTAG ports HANG opens when
  the chip is wedged, and two readers steal bytes from each other.
- Matches the response by id AND presence of result/error: the console echoes
  the request line back, which otherwise parses as a false match.
- CP2102 ports (ttyUSB*) assert DTR/RTS on open and can reset the board into
  the bootloader; pass --cp2102 to reset it back into run mode first.
- The device's ESP_LOG output shares this UART with the RPC framing. Non-JSON
  lines are dropped by default; pass --log to echo them to stderr, and
  --linger SECONDS to keep reading after the response so a log line emitted by
  what the call triggered (a deferred UI action, a send) is not cut off. This
  is the only way to watch a node's log while driving it, since the port
  admits one reader.
"""
import argparse, json, sys, time

try:
    import serial
except ImportError:
    sys.stderr.write(
        "pyserial not found. Run with an interpreter that has it, e.g.\n"
        "  ~/.local/share/pipx/venvs/esptool/bin/python scripts/bramble-rpc ...\n")
    sys.exit(2)

p = argparse.ArgumentParser()
p.add_argument('port')
p.add_argument('method')
p.add_argument('params', nargs='?')
p.add_argument('--timeout', type=float, default=8.0)
p.add_argument('--cp2102', action='store_true', help='reset into run mode after open')
p.add_argument('--log', action='store_true', help='echo the device log lines to stderr')
p.add_argument('--linger', type=float, default=0.0,
               help='keep reading (and logging) this many seconds after the response')
a = p.parse_args()

s = serial.Serial(a.port, 115200, timeout=0.3, exclusive=True)
if a.cp2102:
    s.setDTR(False); s.setRTS(True); time.sleep(0.1); s.setRTS(False); time.sleep(4)
time.sleep(0.3)
s.reset_input_buffer()
req = {"jsonrpc": "2.0", "id": 1, "method": a.method}
if a.params:
    req["params"] = json.loads(a.params)
s.write((json.dumps(req) + "\r\n").encode())
buf = ''
result = None
deadline = time.time() + a.timeout
# Lines are consumed as they complete, so a partial tail is never re-scanned
# (the old whole-buffer rescan re-examined every line on every read; harmless
# for a single response, wrong once lines are echoed as they arrive).
while time.time() < deadline:
    buf += s.read(4096).decode('utf-8', 'replace')
    while '\n' in buf:
        line, buf = buf.split('\n', 1)
        line = line.strip()
        if not line:
            continue
        if not line.startswith('{'):
            if a.log:
                print(line, file=sys.stderr)
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            if a.log:
                print(line, file=sys.stderr)
            continue
        if result is None and msg.get('id') == 1 and ('result' in msg or 'error' in msg):
            result = msg.get('result', msg.get('error'))
            # Stop at the response unless asked to linger for the log that
            # whatever this call triggered is about to emit.
            deadline = (time.time() + a.linger) if a.linger > 0 else 0
        elif a.log:
            print(line, file=sys.stderr)
s.close()
if result is None:
    print("timeout: no response", file=sys.stderr)
    sys.exit(1)
print(json.dumps(result, indent=2))
