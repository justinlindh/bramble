{
  "name": "Mailbox Store-and-Forward",
  "description": "5-node linear mesh testing store-and-forward delivery via a mailbox node. Node E goes offline; Node A sends messages that Node B (mailbox) holds. When E rejoins, B delivers queued messages.",
  "seed": 1002,
  "duration_ms": 120000,
  "radio": {
    "range": 150,
    "loss_pct": 2,
    "propagation_speed_ms_per_unit": 0.1
  },
  "nodes": [
    { "id": "A", "x": 0,   "y": 0, "role": "normal" },
    { "id": "B", "x": 100, "y": 0, "role": "mailbox", "mailbox": true },
    { "id": "C", "x": 200, "y": 0, "role": "normal" },
    { "id": "D", "x": 300, "y": 0, "role": "normal" },
    { "id": "E", "x": 400, "y": 0, "role": "normal" }
  ],
  "events": [
    {
      "type": "send_message",
      "at_ms": 8000,
      "src": "A",
      "dest": "E",
      "payload": "pre-offline message"
    },
    {
      "type": "kill_node",
      "at_ms": 20000,
      "node": "E"
    },
    {
      "type": "send_message",
      "at_ms": 25000,
      "src": "A",
      "dest": "E",
      "payload": "queued message 1"
    },
    {
      "type": "send_message",
      "at_ms": 35000,
      "src": "A",
      "dest": "E",
      "payload": "queued message 2"
    },
    {
      "type": "send_message",
      "at_ms": 45000,
      "src": "A",
      "dest": "E",
      "payload": "queued message 3"
    },
    {
      "type": "send_message",
      "at_ms": 55000,
      "src": "C",
      "dest": "E",
      "payload": "queued from C"
    },
    {
      "type": "node_join",
      "at_ms": 75000,
      "node": "E",
      "x": 400,
      "y": 0
    },
    {
      "type": "send_message",
      "at_ms": 90000,
      "src": "E",
      "dest": "A",
      "payload": "E back online - ack"
    },
    {
      "type": "send_message",
      "at_ms": 100000,
      "src": "A",
      "dest": "E",
      "payload": "post-rejoin message"
    }
  ]
}
