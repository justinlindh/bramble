{
  "name": "anomaly-route-loop",
  "description": "Route loop detection test. Bramble's RREP routing prevents loops under normal conditions — this scenario uses rapid topology changes to attempt creating stale cross-routes. Loops in practice require packet corruption, race conditions, or implementation bugs. The detector serves as a safety net measuring how often hop_limit saves us. NOTE: This scenario may show 0 loops — that validates the routing design. The detector itself is verified via unit test.",
  "mode": "deterministic",
  "duration_ms": 300000,
  "nodes": [
    {"id": "A", "x": 0, "y": 100},
    {"id": "B", "x": 100, "y": 0},
    {"id": "C", "x": 200, "y": 100},
    {"id": "D", "x": 100, "y": 200},
    {"id": "E", "x": 300, "y": 100}
  ],
  "radio": {
    "range": 150,
    "loss_pct": 0,
    "propagation_speed_ms_per_unit": 0.1
  },
  "events": [
    {"at_ms": 35000, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 40000, "type": "send_message", "src": "E", "dest": "A"},
    {"at_ms": 45000, "type": "send_message", "src": "B", "dest": "D"},
    {"at_ms": 50000, "type": "send_message", "src": "D", "dest": "B"},

    {"at_ms": 60000, "type": "kill_node", "node": "C"},
    {"at_ms": 60100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 60200, "type": "send_message", "src": "B", "dest": "E"},
    {"at_ms": 60300, "type": "send_message", "src": "D", "dest": "E"},

    {"at_ms": 61000, "type": "node_join", "node": "C"},
    {"at_ms": 61100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 61200, "type": "send_message", "src": "E", "dest": "A"},

    {"at_ms": 63000, "type": "kill_node", "node": "C"},
    {"at_ms": 63100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 63200, "type": "send_message", "src": "E", "dest": "A"},

    {"at_ms": 64000, "type": "node_join", "node": "C"},
    {"at_ms": 64100, "type": "send_message", "src": "B", "dest": "D"},
    {"at_ms": 64200, "type": "send_message", "src": "D", "dest": "B"},

    {"at_ms": 66000, "type": "kill_node", "node": "C"},
    {"at_ms": 66100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 67000, "type": "node_join", "node": "C"},
    {"at_ms": 67100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 68000, "type": "kill_node", "node": "C"},
    {"at_ms": 68100, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 69000, "type": "node_join", "node": "C"},

    {"at_ms": 100000, "type": "send_message", "src": "A", "dest": "E"},
    {"at_ms": 110000, "type": "send_message", "src": "E", "dest": "A"},
    {"at_ms": 120000, "type": "send_message", "src": "B", "dest": "D"},
    {"at_ms": 130000, "type": "send_message", "src": "D", "dest": "B"}
  ]
}
