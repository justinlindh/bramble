{
  "name": "anomaly-excessive-rreq",
  "description": "Excessive RREQ: Node D is killed before any routes to it exist, then A repeatedly sends messages to D at >5s intervals. Each attempt starts a fresh RREQ discovery that fails. 6+ originations in 10s on forwarding nodes should trigger excessive_rreq.",
  "mode": "deterministic",
  "duration_ms": 180000,
  "nodes": [
    {"id": "A", "x": 0, "y": 0},
    {"id": "B", "x": 100, "y": 0},
    {"id": "C", "x": 200, "y": 0},
    {"id": "D", "x": 300, "y": 0}
  ],
  "radio": {
    "range": 150,
    "loss_pct": 0,
    "propagation_speed_ms_per_unit": 0.1
  },
  "events": [
    {"at_ms": 5000, "type": "kill_node", "node": "D"},

    {"at_ms": 35000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 41000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 47000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 53000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 59000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 65000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 71000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 77000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 83000, "type": "send_message", "src": "A", "dest": "D"},
    {"at_ms": 89000, "type": "send_message", "src": "A", "dest": "D"},

    {"at_ms": 130000, "type": "node_join", "node": "D"},
    {"at_ms": 165000, "type": "send_message", "src": "A", "dest": "D"}
  ]
}
