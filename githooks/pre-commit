#!/usr/bin/env bash
set -e

# Clang-format: check staged C/H files (fast, catches formatting before CI does)
staged_c=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h' | head -1)
if [[ -n "$staged_c" ]] && command -v clang-format >/dev/null 2>&1; then
    bash scripts/lint/run-clang-format-check.sh --changed
fi

# Em dashes are banned repo-wide (see CLAUDE.md); check added lines only
if git diff --cached -U0 | grep -q $'^+.*\xe2\x80\x94'; then
    echo "pre-commit: em dash found in staged changes (banned repo-wide)" >&2
    exit 1
fi

# Typecheck + unit tests
make -s check-fast
